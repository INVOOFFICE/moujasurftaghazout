---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { image } from '../data/loaders';

const hero = image('blog_post_1');

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="MOUJA TAGHAZOUT Surf & Travel Journal"
  description="Surf tips, travel guides, and stories from the heart of Moroccan surf culture. Read the MOUJA TAGHAZOUT journal."
  canonical="/blog"
  bodyClass="page-blog"
  breadcrumb={['Blog']}
>
  <section class="detail-hero">
    <img src={hero.src} alt={hero.alt} />
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Blog</span>
      </nav>
      <h1>The MOUJA TAGHAZOUT Journal</h1>
      <p>Surf tips, travel guides, and stories from the heart of Moroccan surf culture.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-2">
        {posts.map((post) => (
          <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="post-card">
            <div class="post-card__body">
              <div class="post-card__meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                <span>{post.data.author}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p class="post-card__excerpt">{post.data.description}</p>
              <span class="btn btn-outline btn-sm">Read Article</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="cta-banner">
        <h2>Ready to Write Your Own Story?</h2>
        <p>Book your surf week in Taghazout and start your own chapter.</p>
        <a class="btn btn-primary btn-lg" href="/booking">Book Your Trip</a>
      </div>
    </div>
  </section>
</BaseLayout>
