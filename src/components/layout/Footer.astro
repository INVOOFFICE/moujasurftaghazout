--- 
import { socials, SITE, image } from '../../data/loaders';

const iconPaths: Record<string, string> = {
  Facebook:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3l.5-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.4C16.7.3 15.7.2 14.6.2 12.2.2 10.5 1.7 10.5 4.4V6H7.5v3h3v9h3.5V9z"/></svg>',
  Instagram:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>',
  Pinterest:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.7-4.1-4.2-4.1-2.9 0-4.6 2.1-4.6 4.4 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.2.2-.4.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2 1-.9 2.2-1.3 3 .9.3 1.9.4 2.9.4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>',
  WhatsApp:
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4-1.1l-.3-.2-3.1.8.8-3-.2-.3A8 8 0 1 1 12 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3.2-.5 0-.2 0-.3-.1-.5-.1-.2-.6-1.4-.8-2-.2-.4-.4-.4-.5-.4h-.4c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.3c.1.2 1.6 2.5 3.9 3.5.5.2.9.4 1.3.5.5.2 1 .2 1.3.1.4-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.1-.2-.2-.5-.3z"/></svg>',
};

const cols = [
  {
    title: 'Surf Camp',
    links: [
      { label: 'Our Surf Camp', href: '/surf-camp' },
      { label: 'Packages', href: '/packages' },
      { label: 'Surf & Yoga', href: '/surf-yoga' },
      { label: 'Activities', href: '/activities' },
    ],
  },
  {
    title: 'Stay & Eat',
    links: [
      { label: 'Accommodation', href: '/accommodation' },
      { label: 'Restaurant', href: '/restaurant' },
      { label: 'Surf Shop', href: '/surf-shop' },
      { label: 'Book Your Stay', href: '/booking' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Blog', href: '/blog' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Company Info', href: '/company' },
    ],
  },
];
---

<footer class="site-foot">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img class="brand-logo" src={image('brand_logo').src} alt="" width="48" height="48" loading="lazy" />
      <span class="brand-word">MOUJA TAGHAZOUT<small>Beach Front Surf &amp; Yoga Camp</small></span>
      <p>{SITE.tagline}</p>
      <p class="footer-note">{SITE.address}</p>
      <div class="footer-socials">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
            <span set:html={iconPaths[s.label] ?? ''} />
          </a>
        ))}
      </div>
    </div>

    {cols.map((c) => (
      <div class="footer-col">
        <h4>{c.title}</h4>
        <ul>
          {c.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
    <nav aria-label="Legal">
      <a href="/terms">Terms &amp; Conditions</a>
      <a href="/cookies">Cookie Policy</a>
      <a href="/company">Company Info</a>
    </nav>
  </div>
</footer>
